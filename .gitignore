# Upstream source snapshots without redistribution rights. The locked manifest
# records their revisions and the notebook fetches them at runtime.
Models/author_releases/
Models/upstream_jscc_models/
Models/additional_reference_checkout/
Models/DeepJSCC/checkpoint_source/
Models/DeepJSCC/root_checkout/
Models/NTSCC/official/
