Models/NTSCC++/official/
Models/SQ-GAN/official/
Models/SQ-GAN/official_working_copy/
Models/SwinJSCC/local_source/
Models/SwinJSCC/official_working_copy/

# Unrelated scheduler project archive and nested source checkout.
Results/SemanticSchedulerEnd2End/
Results/SQGAN/recovery_v15/SQ-GAN/
# Generated native upstream sources and local execution outputs
.upstream/
*.egg-info/
Results/experiments/
Results/metrics.csv
Results/metrics.csv.lock

# Author checkpoints are downloaded from their provenance ledger, not Git blobs
Models/pretrained_downloads/
Results/implementation_checks/
